     <input id="reserve" type="number" min="0" placeholder="مثال: 500" value="0">
    </div>
    <div class="field">
     <label>وش هي احتياجاتك؟ اختار ما ينطبق عليك</label>
     <div class="checks">
      <label><input type="checkbox" name="need" value="food"> مواد غذائية</label>
      <label><input type="checkbox" name="need" value="home"> مستلزمات البيت</label>
      <label><input type="checkbox" name="need" value="study"> دراسة</label>
      <label><input type="checkbox" name="need" value="health"> صحة ونظافة</label>
      <label><input type="checkbox" name="need" value="clothes"> ملابس</label>
