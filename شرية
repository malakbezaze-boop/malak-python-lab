<div class="toast" id="toast" role="status"></div>

<script>
const $ = id => document.getElementById(id);

$('year').textContent = new Date().getFullYear();

function toast(msg) {
 const t = $('toast');
 t.textContent = msg;
 t.style.display = 'block';
 setTimeout(() => t.style.display = 'none', 2400);
}

$('planBtn').addEventListener('click', () => {
 const budget = Number($('budget').value);
 const reserve = Math.max(0, Number($('reserve').value) || 0);
 const needs = [...document.querySelectorAll('input[name="need"]:checked')]
  .map(x => x.parentElement.textContent.trim());
 const priority = $('priority').selectedOptions[0].textContent;
 const notes = $('notes').value.trim();

 if (!Number.isFinite(budget) || budget <= 0) {
  $('planResult').innerHTML = '<strong>أدخل مبلغًا صحيحًا.</strong><p>مثال: 5000 دج.</p>';
  return;
 }

 if (reserve > budget) {
  $('planResult').innerHTML = '<strong>المبلغ الاحتياطي أكبر من الميزانية.</strong><p>عدّل المبلغين حتى تكون الخطة منطقية.</p>';
  return;
 }

 const available = budget - reserve;
 let essential = Math.round(available * .6);
 let important = Math.round(available * .25);
 let flexible = available - essential - important;
 const items = needs.length ? needs.join('، ') : 'احتياجاتك الأساسية';

 $('planResult').innerHTML = `
  <h3>ملخص ميزانيتك</h3>
  <p>الميزانية: <strong>${budget.toLocaleString('fr-DZ')} دج</strong></p>
  <p>الاحتياطي: <strong>${reserve.toLocaleString('fr-DZ')} دج</strong></p>
  <p>المتاح للتخطيط: <strong>${available.toLocaleString('fr-DZ')} دج</strong></p>
  <hr>
  <p>حسب المعلومات التي أدخلتها، احتياجاتك: <strong>${escapeHtml(items)}</strong>.</p>
  <ul>
   <li>حوالي 60% (${essential.toLocaleString('fr-DZ')} دج) للضروريات.</li>
   <li>حوالي 25% (${important.toLocaleString('fr-DZ')} دج) للاحتياجات المهمة: ${escapeHtml(priority)}.</li>
   <li>حوالي 15% (${flexible.toLocaleString('fr-DZ')} دج) مرونة أو احتياجات يمكن تأجيلها.</li>
  </ul>
  <p>راجع هذه النسب حسب ظروفك الحقيقية؛ إذا كانت لديك حاجة أساسية مستعجلة، أعطها الأولوية.</p>
  ${notes ? '<p><strong>ملاحظاتك:</strong> ' + escapeHtml(notes) + '</p>' : ''}
  <p class="small">هذه قسمة إرشادية عامة وليست نصيحة مالية شخصية أو أسعارًا مؤكدة.</p>
 `;
});

function escapeHtml(s) {
 return s.replace(/[&<>"']/g, c => ({
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;'
 }[c]));
}

document.querySelectorAll('[data-tab]').forEach(btn => {
 btn.addEventListener('click', () => {
  document.querySelectorAll('[data-tab]').forEach(b =>
   b.classList.toggle('active', b === btn)
  );
  ['shop', 'supplier', 'directory'].forEach(n =>
   $('panel-' + n).classList.toggle('hidden', n !== btn.dataset.tab)
  );
 });
});

function showMessage(id, text, copyId) {
 $(id).textContent = text;
 $(id).classList.remove('hidden');
 $(copyId).classList.remove('hidden');
}

$('makeShopMsg').addEventListener('click', () => {
 const name = $('shopName').value.trim();
 const city = $('shopCity').value.trim();
 const goods = $('shopGoods').value.trim();
 const qty = $('shopQty').value.trim();

 if (!name || !goods) {
  toast('اكتب اسم المحل والمنتجات المطلوبة أولًا.');
  return;
 }

 const msg = `طلب توريد عبر شرية SHERYA
اسم المحل: ${name}
الولاية/البلدية: ${city || 'غير محدد'}
المنتجات المطلوبة: ${goods}
الكمية والتفاصيل: ${qty || 'يرجى التواصل للتفاصيل'}
هذه رسالة طلب أولية، يرجى تأكيد الأسعار والتوفر وموعد التسليم مباشرة.`;

 showMessage('shopMessage', msg, 'copyShopMsg');
});

$('makeSupplierMsg').addEventListener('click', () => {
 const name = $('supplierName').value.trim();
 const city = $('supplierCity').value.trim();
 const goods = $('supplierGoods').value.trim();
 const contact = $('supplierContact').value.trim();

 if (!name || !goods) {
  toast('اكتب اسم المؤسسة والمنتجات المتوفرة أولًا.');
  return;
 }

 const msg = `بطاقة مورد / موزّع — شرية SHERYA
اسم المؤسسة: ${name}
منطقة التوزيع: ${city || 'غير محدد'}
المنتجات: ${goods}
وسيلة التواصل: ${contact || 'تضاف عند التواصل'}
يرجى تأكيد الأسعار والتوفر وشروط التوريد مباشرة.`;

 showMessage('supplierMessage', msg, 'copySupplierMsg');
});

async function copyText(id) {
 try {
  await navigator.clipboard.writeText($(id).textContent);
  toast('تم نسخ النص. يمكنك لصقه في رسالة أو بريد.');
 } catch (e) {
  toast('حدّد النص وانسخه يدويًا.');
 }
}

$('copyShopMsg').addEventListener('click', () => copyText('shopMessage'));
$('copySupplierMsg').addEventListener('click', () => copyText('supplierMessage'));
</script>
</body>
</html>
